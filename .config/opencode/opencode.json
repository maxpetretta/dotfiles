{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    },
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456/v1",
        "apiKey": "x"
      }
    }
  },
  "plugins": [
    "/Users/max/.config/opencode/meridian-autostart/v2",
    "/Users/max/.local/share/mise/installs/npm-rynfar-meridian/latest/node_modules/@rynfar/meridian/dist/meridian-v2"
  ],
  "providers": {
    "anthropic": {
      "settings": {
        "apiKey": "x",
        "baseURL": "http://127.0.0.1:3456/v1"
      }
    }
  }
}
