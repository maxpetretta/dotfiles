<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
		<key>PATH</key>
		<string>/Users/max/.local/share/mise/shims:/Users/max/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>com.max.cursor-worker</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/cursor-agent</string>
		<string>worker</string>
		<string>--computer-use</string>
		<string>start</string>
		<string>--name</string>
		<string>mba15</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/max/Library/Logs/cursor-worker.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/max/Library/Logs/cursor-worker.out.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>/Users/max</string>
</dict>
</plist>
