<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>BLACKOUT_IDLE_SECONDS</key>
		<string>600</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.max.display-blackout</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/Users/max/dev/dotfiles/.config/blackout/display-blackout.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/max/Library/Logs/display-blackout.log</string>
	<key>StandardOutPath</key>
	<string>/Users/max/Library/Logs/display-blackout.log</string>
</dict>
</plist>
