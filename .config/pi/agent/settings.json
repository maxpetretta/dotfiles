{
  "packages": [
    {
      "source": "../../dev/pi-enhanced",
      "extensions": []
    },
    "npm:pi-claude-bridge"
  ],
  "extensions": [
    "!**"
  ],
  "lastChangelogVersion": "1.0.0",
  "defaultThinkingLevel": "high",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "piEnhanced": {
    "features": {
      "alert": {
        "enabled": true
      },
      "editor": {
        "enabled": true
      },
      "help": {
        "enabled": true,
        "panelPosition": "right"
      },
      "footer": {
        "enabled": true
      },
      "stash": {
        "enabled": true,
        "shortcut": "alt+s",
        "filePath": ".pi/stash.md"
      },
      "upgrade": {
        "enabled": true,
        "checkOnStart": true
      },
      "fastMode": {
        "enabled": true,
        "defaultOn": true
      },
      "planUsage": {
        "enabled": true
      },
      "compactTools": {
        "enabled": true,
        "mode": "compact",
        "maxPreviewLines": 10,
        "experimentalTransparentToolBackground": true
      }
    }
  },
  "tuiMode": "regular",
  "theme": "dark"
}