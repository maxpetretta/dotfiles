#!/bin/sh
# Install the LaunchAgents in .config/launchd, run by ./install. launchd wants real files in
# ~/Library/LaunchAgents rather than links, so each one is copied there and loaded, but only when it's
# missing. An installed copy that differs from the repo is left alone and reported; to apply a change,
# run: launchctl bootout gui/$(id -u)/<label>, copy the file over, then launchctl bootstrap gui/$(id -u) <file>.
# Agents in $disabled are kept off on every run, installed or not: they're disabled, unloaded if
# running, and copied without being loaded. To turn one back on, remove it from $disabled first.
set -eu
src_dir=$(cd "$(dirname "$0")/../.config/launchd" && pwd)
dest_dir="$HOME/Library/LaunchAgents"
domain="gui/$(id -u)"
# rex-home stays off: the Claude app serves ~/dev over Remote Control, and two hosts can't share a folder.
# cursor-worker stays off until it's wanted again.
disabled="com.max.rex-home com.max.cursor-worker"
mkdir -p "$dest_dir"
for src in "$src_dir"/*.plist; do
  name=$(basename "$src")
  dest="$dest_dir/$name"
  label=${name%.plist}
  case " $disabled " in
    *" $label "*)
      # Disable before copying so launchd never loads it at the next login
      launchctl disable "$domain/$label"
      launchctl bootout "$domain/$label" 2>/dev/null && echo "stopped $label"
      if [ ! -e "$dest" ]; then
        cp "$src" "$dest"
        echo "installed $label (disabled)"
      fi
      ;;
    *)
      if [ ! -e "$dest" ]; then
        cp "$src" "$dest"
        launchctl bootstrap "$domain" "$dest" && echo "installed $label"
      elif ! plutil -convert xml1 -o - "$dest" | cmp -s - "$src"; then
        echo "$label: the installed copy differs from .config/launchd/$name; left as is"
      fi
      ;;
  esac
done
